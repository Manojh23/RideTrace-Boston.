# Copy to .env; Node 20.12+ can load it via node --env-file=.env src/server.js
MONGODB_URI=mongodb://127.0.0.1:27017
# For Atlas, replace the URI above with your private mongodb+srv connection string.
# Both feature collections use the database below. Never commit a real Atlas URI.
MONGODB_DB=ridetrace_boston
APP_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PORT=3000
NODE_ENV=development
