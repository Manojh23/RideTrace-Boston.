{
  "name": "ridetrace-boston",
  "version": "1.0.0",
  "private": true,
  "description": "MBTA commute reliability and community transfer experience web app",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "seed:mbta": "node --env-file=.env scripts/seed-mbta.js",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run test && npm run lint && npm run format:check"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongodb": "^6.17.0"
  },
  "devDependencies": {
    "eslint": "^9.29.0",
    "@eslint/js": "^9.29.0",
    "globals": "^16.2.0",
    "prettier": "^3.6.0"
  },
  "license": "MIT"
}
